        "title": "DescriptionNormalizationCitation",
        "type": "object"
      },
      "DisplayedInputClaim": {
        "properties": {
          "point_id": {
            "title": "Point Id",
            "type": "string"
          },
          "series": {
            "title": "Series",
            "type": "string"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "period": {
            "title": "Period",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Value"
          },
          "value_kind": {
            "$ref": "#/$defs/ValueKind"
          },
          "raw_display": {
            "title": "Raw Display",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/$defs/RoleFieldCitation"
