        "title": "Evidence",
        "type": "object"
      },
      "EvidenceKind": {
        "enum": [
          "native_element",
          "source_text_observation"
        ],
        "title": "EvidenceKind",
        "type": "string"
      },
      "FieldCitation": {
        "properties": {
          "field_path": {
            "title": "Field Path",
            "type": "string"
          },
          "chart_ir_artifact_id": {
            "title": "Chart Ir Artifact Id",
            "type": "string"
          },
          "svg_artifact_id": {
            "title": "Svg Artifact Id",
            "type": "string"
          },
          "svg_digest": {
            "title": "Svg Digest",
            "type": "string"
