          "text_range": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Text Range",
            "type": "array"
          },
          "verification": {
            "$ref": "#/$defs/Verification"
          },
          "confidence": {
            "$ref": "#/$defs/Confidence"
          },
          "scope": {
            "const": "page_context",
            "default": "page_context",
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "source_manifest_id",
          "source_text_sha256",
          "source_span_id",
          "text",
          "source",
          "text_range",
          "verification",
          "confidence"
