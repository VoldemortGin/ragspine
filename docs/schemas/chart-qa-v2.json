  "ChartQueryErrorResponse": {
    "$defs": {
      "ChartQueryErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "pin_conflict",
              "invalid_evidence",
              "unavailable_evidence"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ChartQueryErrorDetail",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "error": {
