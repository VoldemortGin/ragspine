          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          },
          "rule_version": {
            "title": "Rule Version",
            "type": "string"
          },
          "verification": {
            "$ref": "#/$defs/Verification"
          },
          "confidence": {
            "$ref": "#/$defs/Confidence"
