        "type": "string"
      },
      "SourceAnchor": {
        "properties": {
          "source_revision": {
            "title": "Source Revision",
            "type": "string"
          },
          "document_sha256": {
            "title": "Document Sha256",
            "type": "string"
          },
          "page_index": {
            "title": "Page Index",
            "type": "integer"
          },
          "bbox": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
