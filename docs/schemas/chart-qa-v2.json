            "title": "Element Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "anchor": {
            "$ref": "#/$defs/SourceAnchor"
          },
          "evidence_kind": {
            "$ref": "#/$defs/EvidenceKind",
            "default": "native_element"
          },
          "source_span_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
