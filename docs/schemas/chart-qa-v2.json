{
  "DisplayedChartQueryRequest": {
    "$defs": {
      "PointSelectorInput": {
        "additionalProperties": false,
        "properties": {
          "point_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Point Id",
            "type": "string"
          },
          "category": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Category",
            "type": "string"
          }
        },
        "required": [
          "point_id",
          "category"
        ],
        "title": "PointSelectorInput",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "chart-qa-v2",
        "title": "Schema Version",
        "type": "string"
      },
      "kind": {
        "const": "chart",
        "title": "Kind",
        "type": "string"
      },
      "processing_id": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Processing Id",
        "type": "string"
      },
      "snapshot_id": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Snapshot Id",
        "type": "string"
      },
      "member_id": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Member Id",
        "type": "string"
      },
      "operation": {
        "const": "lookup",
        "title": "Operation",
        "type": "string"
      },
      "series": {
        "maxLength": 256,
        "minLength": 1,
        "title": "Series",
        "type": "string"
      },
      "period": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Period",
        "type": "string"
      },
      "unit": {
        "maxLength": 32,
        "minLength": 1,
        "title": "Unit",
        "type": "string"
      },
      "points": {
        "items": {
          "$ref": "#/$defs/PointSelectorInput"
        },
        "maxItems": 1,
        "minItems": 1,
        "title": "Points",
        "type": "array"
      }
    },
    "required": [
      "schema_version",
      "kind",
      "processing_id",
      "snapshot_id",
      "member_id",
      "operation",
      "series",
      "period",
      "unit",
      "points"
    ],
    "title": "DisplayedChartQueryRequest",
    "type": "object"
  },
  "DisplayedChartQueryResponse": {
    "$defs": {
      "AnswerValue": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Value"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value_kind": {
            "$ref": "#/$defs/ValueKind"
          },
          "raw_display": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Display"
          },
          "verification": {
            "$ref": "#/$defs/Verification"
          },
          "confidence": {
            "$ref": "#/$defs/Confidence"
          }
        },
        "required": [
          "value",
          "unit",
          "value_kind",
          "raw_display",
          "verification",
          "confidence"
        ],
        "title": "AnswerValue",
        "type": "object"
      },
      "Confidence": {
        "properties": {
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "method": {
            "title": "Method",
            "type": "string"
          }
        },
        "required": [
          "score",
          "method"
        ],
        "title": "Confidence",
        "type": "object"
      },
      "DescriptionNormalizationCitation": {
        "description": "Audit provenance only; repairing duplicate IDs does not qualify a fact.",
        "properties": {
          "binding": {
            "$ref": "#/$defs/SvgBinding"
          },
          "receipt_id": {
            "title": "Receipt Id",
            "type": "string"
          },
          "raw_response_sha256": {
            "title": "Raw Response Sha256",
            "type": "string"
          },
          "original_typed_description_artifact_id": {
            "title": "Original Typed Description Artifact Id",
            "type": "string"
          },
          "normalized_description_artifact_id": {
            "title": "Normalized Description Artifact Id",
            "type": "string"
          },
          "rule_version": {
            "title": "Rule Version",
            "type": "string"
          }
        },
        "required": [
          "binding",
          "receipt_id",
          "raw_response_sha256",
          "original_typed_description_artifact_id",
          "normalized_description_artifact_id",
          "rule_version"
