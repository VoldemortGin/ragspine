          "raw_chart_ir_artifact_id": {
            "title": "Raw Chart Ir Artifact Id",
            "type": "string"
          },
          "point_id": {
            "title": "Point Id",
            "type": "string"
          },
          "raw_field_path": {
            "title": "Raw Field Path",
            "type": "string"
          },
          "literal": {
            "title": "Literal",
