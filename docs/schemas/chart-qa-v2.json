            "title": "Citations",
            "type": "array"
          },
          "period_interpretation": {
            "$ref": "#/$defs/PointPeriodInterpretation"
          }
        },
        "required": [
          "point_id",
          "series",
          "category",
          "period",
          "unit",
          "value",
          "value_kind",
          "raw_display",
          "citations",
          "period_interpretation"
        ],
        "title": "DisplayedInputClaim",
        "type": "object"
      },
      "DisplayedRefusalReason": {
        "enum": [
          "unqualified_member",
          "unsupported_operation",
          "unsupported_grammar",
          "unknown_point",
          "value_unavailable",
          "series_mismatch",
          "category_mismatch",
          "period_mismatch",
          "unit_mismatch",
