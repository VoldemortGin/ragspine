# ============================================================================
# ragspine / enterprise-pdf-rag 环境变量样例。复制为 .env 后填值（.env 已被 .gitignore 忽略）。
#
#   cp .env.example .env
#
# 约定：
#   - 必填变量直接写出（无默认值的留空，需自行填写）；可选变量以注释形式给出代码内默认值。
#   - 密钥类（*_API_KEY）在本样例里只放占位符；真实值写进 .env（不提交），不要写回本文件。
#   - APP_* 由 src/ragspine/common/evidence/configs.py（pydantic-settings）自动读取：
#     优先级 真实环境变量 > 项目根 .env > config/enterprise-pdf-rag/settings.yaml > 代码默认值。
#     .env 固定在项目根（APP_ROOT_DIR 或向上找到 .project-root 的目录），与 CWD 无关；
#     不存在也不报错。notebook / CLI 直接可用，无需 source。
#   - 本文件中【非 APP_ 前缀】的变量里，只有 NB_*（notebook 路径，含别名 DATASET_PATH）与 OPENAI_API_KEY / OPENAI_BASE_URL /
#     OPENAI_MODEL（LLM 首选名）/ OPENAI_EMBEDDING_MODEL（embedding 模型首选名）/ PDF_INGEST_PASSWORD（加密 PDF 口令）经 configs 读取；其余（ENTERPRISE_* / RAGSPINE_* 等）不经 configs，
#     .env 里写了也不会生效，仍需以环境变量提供。
#   - 受控子进程（with_local_models.py / webui_preview.py 起的进程）带 PYTHON_DOTENV_DISABLED=1，
#     自己不读 .env，只收父进程按白名单传入的值。
#   - 给变量赋【空串】会覆盖代码默认值；不需要的可选项请保持注释。
# ============================================================================

# ---- 项目根 / 路径 -----------------------------------------------------------
# 可选。项目根目录（绝对路径，必须是已存在目录）。缺省从 CWD 向上找 .project-root；
# wheel / 容器 / 项目树外运行（如 notebook 不在仓库内）时必填。
# 注意：此变量决定 .env 的位置，只能是真实环境变量（写在 .env 里无效）；不是 Settings 字段。
# APP_ROOT_DIR=/absolute/path/to/ragspine

# 可选。运行期可写数据目录，相对路径相对项目根解析。默认 <root>/data。
# APP_DATA_DIR=data
# 可选。日志目录，相对路径相对项目根解析。默认 <root>/logs。
# APP_LOG_DIR=logs

# ---- LLM（OpenAI 兼容，云端；图表 IR / 视觉语义加工 / 文档问答 / llm-smoke）------
# 仅这三项有别名：首选 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL，APP_LLM_API_KEY /
# APP_LLM_BASE_URL / APP_LLM_MODEL 是等价别名（下面注释掉的行），逐字段读取，两种写法都能用。
# 优先级：同一来源内 OPENAI_* > APP_LLM_*；来源之间仍是 真实环境变量 > .env，且按来源整体比较——
# 所以 shell 里的 APP_LLM_MODEL 会盖过 .env 里的 OPENAI_MODEL；想让 .env 说了算就别在 shell 里导出这些名字。
# embedding 模型名另有首选名 OPENAI_EMBEDDING_MODEL（见下）；rerank / 隧道没有别名。受控子进程（launcher / webui_preview）只收到解析后的 APP_LLM_*，
# 不会收到 OPENAI_*；base URL 仍只接受 https。
# 用到 LLM 的阶段必填（缺失只在该阶段报错）。云端 LLM key；占位符，勿提交真值。
OPENAI_API_KEY=sk-...
# APP_LLM_API_KEY=
# 同上必填。云端 LLM base URL；只接受 https，且不得含用户名/密码/query/fragment。
OPENAI_BASE_URL=
# APP_LLM_BASE_URL=
# 同上必填。模型名（如网关侧部署名）。
OPENAI_MODEL=
# APP_LLM_MODEL=
# 可选。采样温度（APP_LLM_TEMPERATURE 是等价别名）。不设或留空 → 0.0（贪心解码，默认）；
# 填 0~2 的数值 → 发送该值；填 omit → 请求体不带 temperature，由端点用它自己的默认值
# （只接受默认温度的模型用它，例如 Azure OpenAI 上的部分推理模型）。其它写法在用到 LLM 时报错。
# 不设也能跑这类端点：端点以 HTTP 400 且 error.param=temperature 明确拒绝时，管线自动去掉它重发，
# 每个进程只多一次被拒请求（见 docs/enterprise-pdf-rag/adr/0021-sampling-parameter-fallback.md）；
# 设 omit 可省掉这一次探测。温度属于请求体，改它会改变请求指纹，等于换一份补全缓存。
# OPENAI_TEMPERATURE=omit
# APP_LLM_TEMPERATURE=

# ---- Embedding（默认与 LLM 同一个 OpenAI 兼容网关）--------------------------------
# 用到 embedding 的阶段必填（检索 / 建索引）。embedding 模型名（网关侧的 /v1/embeddings 模型）；
# 只填它时 embedding 走 OPENAI_BASE_URL、用 OPENAI_API_KEY。其 fingerprint（local-http/<模型名>）
# 与向量维度须与已发布索引一致。APP_EMBEDDING_MODEL 是等价别名。
OPENAI_EMBEDDING_MODEL=
# 网关上 embedding 用的 key 与 LLM 不同时：只设下面的 APP_EMBEDDING_API_KEY（只覆盖 key，地址仍是
# OPENAI_BASE_URL；不设 APP_EMBEDDING_BASE_URL）。走 OPENAI_* 网关时不要写 APP_EMBEDDING_API_KEY=... 这样的占位行：
# 值恰为 ... 会被当作模板占位符直接报错（不想覆盖 key 就整行删掉）。
# 隐私：未配独立的 APP_EMBEDDING_BASE_URL、embedding 走 OPENAI_BASE_URL 网关时，文档片段（chunk）文本与查询文本
# 会发往该 LLM 网关；要让文本留在本机，请显式配置 loopback 的 APP_EMBEDDING_*（见下）。
#
# 可选：独立的 loopback embedding 服务（经 SSH 隧道的 vLLM）。设了 APP_EMBEDDING_BASE_URL 就不再走网关，
# 三项都必填；地址只接受 127.0.0.1 / localhost / ::1（http 或 https），key 不会回退到 LLM key。
# 例：http://127.0.0.1:39002（隧道本地端口，见 APP_TUNNEL_EMBEDDING_LOCAL_PORT）
# APP_EMBEDDING_BASE_URL=
# APP_EMBEDDING_MODEL=
# embedding 服务 key；可直接写在 .env，或由受控 launcher
# （scripts/enterprise_pdf_rag/with_local_models.py）经 SSH 读取后注入子进程。
# APP_EMBEDDING_API_KEY=
# 可选。文档并行入库（run_folder 的 MAX_PARALLEL_DOCUMENTS > 1，ADR 0033）时共享 embedder 同时在途的请求数上限，
# 须 ≥ 1（ADR 0042）；注入的、不按线程计数的 embedder 仍一次一个。推荐 MAX_PARALLEL_DOCUMENTS=4。默认 4。
# APP_EMBEDDING_MAX_CONCURRENCY=4
# 可选。每个 /v1/embeddings 请求的 input 条数（1-1024，默认 16）与字符数（≥1000，默认 48000）上限，先到者为准（ADR 0026）。
# 远程网关 RTT 高时调大可成倍减少请求数：推荐 BATCH_MAX_ITEMS=64 配 MAX_CONCURRENCY=4（同时在途约 256 条）。
# 调大前确认网关单请求上限（vLLM 默认 max-num-seqs / token 上限、网关请求体大小）；超限时失败批会对半拆，但每次失败都多花一次请求。
# APP_EMBEDDING_BATCH_MAX_ITEMS=16
# APP_EMBEDDING_BATCH_MAX_CHARS=48000
# 可选。文档内页级并发（ADR 0045）：一份文档同时处理的页数，回退页版面调用与对象语义调用共用这 N 个
# 名额，产物与串行逐字节相同；1–16，默认 1（逐页串行）。总在途请求 ≈ MAX_PARALLEL_DOCUMENTS × N，推荐 4 × 4。
# APP_PAGE_CONCURRENCY=1
# 可选。回退页送版面模型的 PNG 宽度（像素，64–4096），默认 960；改它会使已缓存的版面结果失效（重跑版面调用）。
# APP_LAYOUT_PNG_WIDTH=960

# ---- Rerank（本地模型，经 SSH 隧道的 vLLM；要求 loopback 地址；没有网关回退）---------
# document-catalog 问答链路必填（服务启动时构造 rerank judge）。要求 loopback。
# 例：http://127.0.0.1:39001
APP_RERANK_BASE_URL=
# document-catalog 必填。rerank 模型名。
APP_RERANK_MODEL=
# document-catalog 必填。rerank 服务 key；占位符。可直接写在 .env，或由 with_local_models.py 注入。
APP_RERANK_API_KEY=...

# ---- 本地模型 SSH 隧道（scripts/enterprise_pdf_rag/local_model_tunnel.py / with_local_models.py）----
# 仅在用受管 SSH 隧道访问远端 vLLM 时需要；以下六项 + 两个容器名全部必填（无默认）。
# 下列数值只是示例，不是代码默认值。
# APP_TUNNEL_SSH_HOST=                     # SSH 主机（字符串，仅 [A-Za-z0-9_.@:-]，不得以 - 开头）
# APP_TUNNEL_SSH_PORT=22                   # SSH 端口 1-65535
# APP_TUNNEL_EMBEDDING_LOCAL_PORT=39002    # 本机 loopback 端口，须与 APP_TUNNEL_RERANK_LOCAL_PORT 不同
# APP_TUNNEL_EMBEDDING_REMOTE_PORT=        # 远端 embedding 服务端口
# APP_TUNNEL_RERANK_LOCAL_PORT=39001
# APP_TUNNEL_RERANK_REMOTE_PORT=           # 远端 rerank 服务端口
# APP_TUNNEL_EMBEDDING_REMOTE_CONTAINER=   # 远端 embedding vLLM 容器名（with_local_models.py 经 SSH 读其 key）
# APP_TUNNEL_RERANK_REMOTE_CONTAINER=      # 远端 rerank vLLM 容器名

# ---- 服务 / 执行模式（enterprise_pdf_rag，经 pydantic-settings，前缀 APP_）-------
# 必填（默认 unconfigured 会拒绝启动）。取值：
#   unconfigured | offline-demo | production | aia-source-review | document-catalog
# 目标流程（扫描 PDF → 入库 → document-catalog 服务 → eval）用 document-catalog。
APP_EXECUTION_MODE=document-catalog

# 可选。调试开关（DEBUG 日志级别、prompt 缓存等）。默认 false。
# APP_IS_DEBUG=false
# 可选。运行时类型检查（beartype）总开关；仅生产环境设 false。默认 true。
# APP_BEARTYPE_ON=true

# ---- ingestion 存储 / document-catalog ----------------------------------------
# 可选。ingestion / 文档目录根；相对路径相对项目根。默认 <APP_DATA_DIR>/ingestion。
# APP_INGESTION_DIR=
# 可选。兼容旧根目录列表（每项是一个 processing store 根）；pydantic-settings 以 JSON 数组解析，
# 如 ["/path/a","/path/b"]。默认空。
# APP_LEGACY_DOCUMENT_ROOTS=[]
# 可选。"onnx-layout" 版面策略的 PP-DocLayoutV3 模型文件路径（也可填模型所在目录，按默认文件名
# pp_doc_layoutv3.onnx 拼接）。未设或空串 → 退回环境变量 PDFSPINE_ONNX_MODELS 指向的目录。
# 需要可导入的 onnxruntime（`pip install 'pdfspine[onnx]'`）；权重不随 wheel 分发，
# Databricks 上放 Volume 并填绝对路径。默认未设置。
# APP_ONNX_LAYOUT_MODEL=
# 可选。版面路由（deterministic-text-pages / onnx-layout）拿不准的页交给谁（ADR 0039）：
#   model = 每页一次 VLM 版面（默认，行为不变）| onnx-accept = 接受低置信 ONNX 结果、ONNX 无框的页按文字层切块
#   | text-only = 一律不调 VLM 版面，ONNX 之外的页按文字层切块（只出文本对象，那些页的图表不可答）。
# 非 model 时每页都产出版面（预算为 0 也不丢页）；版面策略为 model（含 full 模式）时不起作用。默认 model。
# APP_LAYOUT_FALLBACK=model
# 可选。建索引时只进 lexical（BM25）通道、不送 embedding 的对象种类，逗号分隔、不分大小写
# （Table / Chart / Diagram / Formula / List / Group；Text 不可）。图表的 BM25 文本取 PDF 文字层。
# 种类写进索引版本，改它会重建索引。候选值 table,chart（向量数大减）；融合时这类对象缺的向量项
# 按 BM25 项补齐（ADR 0043 修正 1），但图表失去向量通道信号，离线评估 MRR 仍低于默认，暂不推荐。
# 默认空 = 两个通道照旧。
# APP_INDEX_LEXICAL_ONLY_KINDS=table,chart
# 可选。document-catalog 聊天端点整进程的真实模型调用预算（缓存回放不计，用尽返回 503）。默认 200。
# APP_ANSWER_MAX_LIVE_CALLS=200
# 可选。单次模型调用等待上限（秒），须在 (0, 180]。默认 45。
# APP_ANSWER_TIMEOUT_SECONDS=45
# 可选。整本 PDF 抽取（extract_document）逐页并行的线程数，1..64；1 即串行。默认 min(4, CPU 数)。产物字节不变（ADR 0040）。
# APP_PDF_EXTRACT_WORKERS=
# 可选。回答模型采样种子（温度见 OPENAI_TEMPERATURE）；留空不可表达 None，需 None 请在 settings.yaml 设 null。默认 0。
# 端点明确拒绝 seed（HTTP 400 且 error.param=seed）时同样自动去掉它重发。
# 改动会改变请求指纹，等于换一份补全缓存。
# APP_ANSWER_SEED=0
# 可选。每个请求都重做挂载时全量校验，且入库流程的存储实例每次读取都全量校验、不复用本实例已校验的
# 结果（审计用，会让问答慢一个数量级、入库读文件次数回到按"页数×对象数"增长）。默认 false。
# APP_VERIFY_EVERY_REQUEST=false
# 可选。持久化校验凭据（ADR 0034）：某阶段完整校验过的快照在 verification-receipts/ 下记一张凭据，
# 之后的阶段 / 进程只要文件 size / mtime / ctime 都没变就用 stat 代替整份重读。false 回到每个实例
# 各全量读一遍；最终发布与所有被使用的字节始终真读。默认 true。
# APP_VERIFY_PERSISTED_RECEIPTS=true
# 可选。问答审计库开关（本地 sqlite，含证据正文，不外发）。默认 true。
# APP_ANSWER_AUDIT_ENABLED=true
# 可选。问答审计库文件路径。默认 <ingestion_root>/answers-audit.sqlite。
# APP_ANSWER_AUDIT_PATH=

# ---- 对象库后端（sqlite 对象库；PR-1 仅新增后端包，store 接线前这些设置不改变任何行为）----
# 可选。存储后端：auto（探测目录上 sqlite 可用即用，否则回退文件布局）| sqlite（显式，
# 探测失败直接报错、绝不静默回退；报错会提示改回 files）| files（今天的文件布局）。默认 auto。
# staged（opt-in，enterprise-pdf-rag ADR 0044 / 0046）：store db 与文档自己的模型缓存都在本地盘工作副本里读写，
# 每个 ingest 阶段结束整文件发布回 store 根（如 Workspace files 的 FUSE）；根级答案缓存仍走文件布局。
# auto 探测失败退到文件布局时会打 warning + trace（failure_code），不再静默。
# Databricks（Workspace files）推荐：
#   APP_OBJECT_STORE_BACKEND=staged
#   APP_OBJECT_STORE_STAGING_DIR=/local_disk0/ragspine-staged
#   入库用 lite（ingest_mode="lite"）；full 的审阅页用 export_document_review 按需生成。
#   这样每份 PDF 在发布目录只留 4 个文件（source/store.sqlite、processing/store.sqlite、
#   processing/model-cache/model-cache.sqlite、PDF 原件）。单文件上限 500 MB：见 ADR 0046；
#   能放 UC Volume（无此上限）就放 Volume。
# APP_OBJECT_STORE_BACKEND=auto
# 可选。staged 的本地工作目录根（每个 store 根一个子目录）。默认 <系统临时目录>/ragspine-staged；
# Databricks 上建议 /local_disk0/ragspine-staged。
# APP_OBJECT_STORE_STAGING_DIR=
# 可选。内联进 db 的对象大小上限（字节）；更大的对象仍外置到 objects/sha256-sharded/。默认 262144；
# staged 下未显式设置时为 8388608（8 MiB，ADR 0046），显式设置仍优先。
# APP_OBJECT_STORE_INLINE_MAX_BYTES=262144
# 可选。无论大小一律外置的媒体类型（逗号分隔）；PDF 原件永远留文件系统。默认 application/pdf。
# APP_OBJECT_STORE_EXTERNAL_MEDIA_TYPES=application/pdf
# 可选。sqlite 的 PRAGMA synchronous：FULL（默认）或 NORMAL（WAL 下可降，换吞吐）。
# APP_OBJECT_STORE_SYNCHRONOUS=FULL
# 可选。单个 store db 的保护阈（字节；默认 419430400 = 400 MiB）：超过后 >16 KiB 的新对象一律外置。
# APP_OBJECT_STORE_MAX_DB_BYTES=419430400
# 可选。派生产物（对象 SVG 裁剪 native_crop / svg、图的 PNG 渲染 model_render）是否落盘（enterprise-pdf-rag ADR 0048）。
# true：照旧落盘，逐字节不变；false：只记 stage 记录与 digest，字节不落盘，读取时从页 SVG + 对象几何确定性重算，
# digest 对不上即拒绝（DerivedArtifactDrift）。不设时：staged 下默认 false，其余后端默认 true；显式设置优先。
# APP_PERSIST_DERIVED_ARTIFACTS=true

# ---- notebook / 一键流程（notebooks/run_folder.ipynb、run_folder_pipeline、enterprise-pdf-rag run-folder）----
# 注意：这三项不带 APP_ 前缀（变量名就叫 NB_*）；相对路径相对项目根，~ 会展开；不校验是否存在；留空等于未设置。
# 调用参数 / 命令行参数始终优先于这里。
# 可选（但不设则 run_folder_pipeline() 与 run-folder 必须显式传 folder / --folder）。PDF 源目录。
# NB_PDF_DIR=~/Documents/pdfs
# 可选。题集：nl-answers-gold-v1 JSON，或 .json/.jsonl/.csv/.txt；不设则只入库、不评测。
# 仅此项有别名 DATASET_PATH（沿用别的项目的变量名也能配到题集）：NB_QUESTIONS_PATH 优先，留空视为未设，
# 此时回落到 DATASET_PATH；相对路径的解析方式相同。优先级沿用 OPENAI_* 的规则：同一来源内主名优先，
# 来源之间仍是 真实环境变量 > .env（shell 里的 DATASET_PATH 会盖过 .env 里的 NB_QUESTIONS_PATH）。
# NB_QUESTIONS_PATH=data/questions/questions.json
# DATASET_PATH=
# 可选。报告目录（写 report.json 与 report.md）；不设则不写报告。仅对 run-folder CLI / 直接调用 run_folder_pipeline() 有效；
# notebooks/run_folder.ipynb 不读它，固定写 <项目根>/data/reports/<题集文件名>/（每次运行都写，PDF 源目录只读）。
# NB_REPORT_DIR=data/reports/run-folder

# ---- 口令加密 PDF（入库，以及之后各阶段 / 服务重新打开源 PDF 时）---------------------
# 注意：变量名不带 APP_ 前缀（与 SuperIndex 同名）；留空等于未设置。
# 可选；需要打开口令的 PDF 必填：未设置或口令不对时该文档以 failed（failed_stage=ingest）结束，
# 错误信息会指明本项。只设了权限口令（打开不需要口令）的 PDF 不需要它。
# 口令只在内存里交给 pdfspine 认证，不进报告 / 进度事件 / 日志 / 入库目录；入库保存的仍是原始加密字节。
# PDF_INGEST_PASSWORD=

# ---- Open WebUI 预览（scripts/enterprise_pdf_rag/webui_preview.py / start.sh）-----
# 可选。API / UI 的 loopback 端口；start 与 status 须使用同一组值。默认 8766 / 8767。
# ENTERPRISE_API_PORT=8766
# ENTERPRISE_WEBUI_PORT=8767
# 可选。预览状态目录（日志、PID 记录、vendor 数据）。默认 <root>/data/open-webui-preview。
# ENTERPRISE_PREVIEW_STATE_DIR=
# 可选。已有的 Open WebUI Python 3.12 解释器路径。默认从 PATH 发现。
# OPEN_WEBUI_PYTHON=
# 可选。仅 document-catalog：启用 Open WebUI 自带登录（值恰为 1 才生效）。默认不启用。
# ENTERPRISE_WEBUI_AUTH=1
# 可选。登录开启后生效：是否允许注册（True/False，按 .lower()=="true" 解析），默认 True。
# ENABLE_SIGNUP=True
# 可选。登录开启后新用户默认角色：pending | user | admin，默认 pending。
# DEFAULT_USER_ROLE=pending

# ---- Eval（问题数据集评测：scripts/run_nl_gold_ragspine.py）-------------------
# 可选。公司画像 TOML 路径（也被 --company-config 参数设置）；默认用内置默认画像。
# 另与 ServiceConfig 的 RAGSPINE_COMPANY_PROFILE 是同一含义的两个名字（见回报）。
# RAGSPINE_COMPANY_CONFIG=config/company.example.toml
# eval 脚本记录 reranker 标识时读取 APP_RERANK_MODEL（见上方 Rerank 分组）。

# ---- ragspine 链路（src/ragspine/，service / retrieval / agent 工厂开关）-----------
# 可选。ServiceConfig 的全部字段均可经 RAGSPINE_<FIELD 大写> 覆盖（service/config.py from_env），
# 完整清单与 compose/helm 用法见 deploy/.env.example；以下仅列常用项。
# RAGSPINE_PROVIDER=mock                # mock | anthropic | claude-cli | litellm | openai（openai 直连 /v1/chat/completions，读上方 OPENAI_*（APP_LLM_* 为别名）；默认 mock；旧别名，规范键 RAGSPINE_PROVIDER_TYPE）
# RAGSPINE_MODEL=                       # anthropic 模型名；留空用内置默认
# RAGSPINE_BASE_URL=                    # anthropic 网关
# ANTHROPIC_API_KEY=sk-ant-...          # provider=anthropic 时必填（SDK 自读；doctor 检查）
# RAGSPINE_LITELLM_MODEL=deepseek/deepseek-chat   # litellm 模型名（agent/litellm_provider.py:194）
# RAGSPINE_LITELLM_API_BASE=            # litellm api_base；留空=厂商默认
# RAGSPINE_LITELLM_IMAGE_INPUT=false    # 1/true/yes/on 才让模型读页图
# RAGSPINE_DB_PATH=data/fact_metric.db  # 事实库路径
# RAGSPINE_REDIS_URL=redis://localhost:6379/0
# RAGSPINE_EMBEDDING=auto               # auto | none | onnx | deterministic | openai | local-http（local-http 读 APP_EMBEDDING_*）
# RAGSPINE_RERANKER=none                # none | local-http（读 APP_RERANK_*）| cross_encoder | colbert | splade | auto
# RAGSPINE_RETRIEVAL_MODE=auto          # auto/hybrid/vector/dense | economy/bm25/lexical/keyword
# RAGSPINE_VECTOR_STORE=none            # none | in_process | sqlite_vec | pgvector | qdrant
# RAGSPINE_PG_URL=                      # pgvector DSN；adapter 直接读环境，仅 vector_store=pgvector 时需要
# RAGSPINE_PERSISTENCE_POLICY=default   # default | persist_everything
# RAGSPINE_EMBEDDING_BACKEND=none       # embedding backend 工厂 spec（none/auto/onnx/local-http/...）
# RAGSPINE_EMBEDDING_MODEL=             # sentence-transformers 类后端的模型覆盖
# RAGSPINE_ONNX_EMBEDDING_MODEL=        # onnx 后端的模型覆盖
# RAGSPINE_EMBEDDING_DEVICE=            # cuda | mps | cpu；留空自动探测
# RAGSPINE_EMBEDDING_QUERY_INSTRUCTION= # local-http embedding 查询前缀指令；空串=关闭，缺省用内置 Qwen3 指令
# RAGSPINE_CROSS_ENCODER_MODEL=         # RAGSPINE_RERANKER 为 cross_encoder 时的模型覆盖
# RAGSPINE_COLBERT_MODEL=               # colbert 模型覆盖
# RAGSPINE_SPLADE_MODEL=                # splade 模型覆盖
# RAGSPINE_COLPALI_MODEL=               # colpali 视觉 embedder 模型覆盖
# RAGSPINE_VISUAL_EMBEDDER=none         # 视觉 embedder spec
# RAGSPINE_CHUNKER=none                 # 切块策略 spec
# RAGSPINE_CONTEXTUAL=none              # 上下文索引 spec
# RAGSPINE_POSTPROCESSOR=none           # 后检索链 spec（mmr / lost_in_middle / compress，逗号成链）
# RAGSPINE_QUERY_TRANSFORM=none         # none | hyde | rag_fusion | step_back
# RAGSPINE_ADAPTIVE=none                # none | heuristic | llm
# RAGSPINE_QUERY_DECOMPOSE=none         # none | llm
# RAGSPINE_CORRECTIVE=none              # none | crag
# RAGSPINE_FILTER_EXTRACTOR=none        # 自动过滤抽取器 spec
# RAGSPINE_LIBRARY_ROUTER=none          # 库路由 spec
# RAGSPINE_RAPTOR=none                  # RAPTOR spec
# RAGSPINE_RAPTOR_SUMMARIZER=none       # RAPTOR 摘要器 spec
# RAGSPINE_TABLE_STRUCTURE=none         # 表格结构识别 spec
# RAGSPINE_GRAPH_STORE=none             # 图存储 spec
# RAGSPINE_NARRATIVE_GRAPH=none         # 叙事图 spec
# RAGSPINE_RELATION_EXTRACTOR=none      # 关系抽取器 spec
# RAGSPINE_FACT_STORE=none              # 事实库后端 spec
# RAGSPINE_SOURCE_CONNECTOR=none        # 来源连接器 spec
# RAGSPINE_TRACE_SINK=none              # trace sink spec
# RAGSPINE_CITATION_MERGE=on            # on | off
# RAGSPINE_NARRATIVE_NUMBER_GUARD=on    # on | off
# RAGSPINE_NARRATIVE_FALLBACK=on        # on | off
# RAGSPINE_LLM_TRUNCATION_RETRY=on      # on | off；输出被截断时翻倍预算重试
# RAGSPINE_LLM_TRUNCATION_MAX_TOKENS=   # 截断重试的输出预算上限；留空用内置默认
# RAGSPINE_DIFY_RUN_ENABLED=false       # 开启 /v1/dify/run（信任边界，默认关）
# RAGSPINE_DIFY_HTTP_ENABLED=false      # 允许 dify http-request 节点出网（1/true/yes/on）

# ---- 测试专用 / CI 专用（日常运行不需要）-------------------------------------
# 仅 pgvector 的 conformance / adapter 测试：未设置则相关测试跳过（tests/conformance/conftest.py:77）。
# RAGSPINE_PG_URL=postgresql://user:pass@127.0.0.1:5432/ragspine
